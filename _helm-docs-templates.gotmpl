{{ define "chart.valueDefaultColumnRender" }}
{{- $defaultValue := (default .Default .AutoDefault)  -}}
{{- $notationType := .NotationType }}
{{- if (and (hasPrefix "`" $defaultValue) (hasSuffix "`" $defaultValue) ) -}}
{{- $defaultValue = (toYaml (fromJson (trimAll "`" (default .Default .AutoDefault) ) ) ) -}}
{{- $notationType = "yaml" }}
{{- end -}}
{{- if (eq $notationType "tpl" ) }}
<pre style="max-width:500px; overflow-x:auto; white-space: pre;" lang="{{ $notationType }}"><code>{{ .Key }}: |
{{- $defaultValue | nindent 2 }}
</code></pre>
{{- else }}
<pre style="width:500px; overflow-x:auto; white-space: pre;" lang="{{ $notationType }}"><code>{{ $defaultValue }}</code></pre>
{{- end }}
{{ end }}

{{ define "chart.descriptionColumnRender" }}
{{- $description := (default .Description .AutoDescription) | replace "\\newline" "\n" -}}
<div>

{{ $description }}

</div>
{{ end }}


{{ define "chart.valuesTableHtml" }}
{{ if .Sections.Sections }}

{{ if .Sections.DefaultSection.SectionItems }}
<h3> Main Values</h3>
<table>
	<thead>
		<th>Key</th>
		<th>Type</th>
		<th>Default</th>
		<th>Description</th>
	</thead>
	<tbody>
	{{- range .Sections.DefaultSection.SectionItems }}
	<tr>
		<td style="width: 300px;">{{ .Key }}</td>
		<td>{{ .Type }}</td>
		<td>{{- template "chart.valueDefaultColumnRender" . -}}</td>
		<td>{{- template "chart.descriptionColumnRender" . -}}</td>
	</tr>
	{{- end }}
	</tbody>
</table>
{{ end }}

{{- range .Sections.Sections }}
<h3>{{- .SectionName }}</h3>
<table>
	<thead>
		<th>Key</th>
		<th>Type</th>
		<th>Default</th>
		<th>Description</th>
	</thead>
	<tbody>
	{{- range .SectionItems }}
		<tr>
			<td style="width: 300px;">{{ .Key }}</td>
			<td>{{ .Type }}</td>
			<td>{{- template "chart.valueDefaultColumnRender" . -}}</td>
			<td>{{- template "chart.descriptionColumnRender" . -}}</td>
		</tr>
	{{- end }}
	</tbody>
</table>
{{- end }}


{{ else }}
<table>
	<thead>
		<th>Key</th>
		<th>Type</th>
		<th>Default</th>
		<th>Description</th>
	</thead>
	<tbody>
	{{- range .Values }}
		<tr>
			<td style="width: 300px;" id="{{ .Key | replace "." "--" }}">{{ .Key }}</td>
			<td>{{ .Type }}</td>
			<td>{{- template "chart.valueDefaultColumnRender" . -}}</td>
			<td>{{- template "chart.descriptionColumnRender" . -}}</td>
		</tr>
	{{- end }}
	</tbody>
</table>
{{ end }}
{{ end }}