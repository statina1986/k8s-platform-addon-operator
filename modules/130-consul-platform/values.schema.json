                  "default": "{\n  \"limits\": {\n    \"http_max_conns_per_client\": 2000\n  },\n  \"rpc\": {\n    \"enable_streaming\": false\n  },\n  \"telemetry\": {\n    \"disable_hostname\": true,\n    \"prometheus_retention_time\": \"168h\"\n  }\n}\n",
