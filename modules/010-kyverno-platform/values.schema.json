                  "type": "boolean"
                },
                "migration": {
                  "properties": {
                    "enabled": {
                      "default": false,
                      "description": "Enable CRDs migration using helm post upgrade hook",
                      "required": [],
                      "title": "enabled",
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "title": "migration",
                  "type": "object"
                }
              },
              "required": [],
