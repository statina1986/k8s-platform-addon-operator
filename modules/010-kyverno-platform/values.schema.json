        "kyverno-policies": {
          "description": "Configuration for underlying Kyverno Policies helm-chart. See https://github.com/kyverno/kyverno/blob/main/charts/kyverno-policies/README.md",
          "properties": {
            "enabled": {
              "default": false,
              "description": "Toggle to enable Kyverno Policies chart deployment",
              "required": [],
