      "required": [],
      "title": "rancherPlatform",
      "type": "object"
    },
    "rancherPlatformNamespace": {
      "default": "cattle-system",
      "description": "Rancher uses different default namespace from normal platform",
      "required": [],
      "title": "rancherPlatformNamespace",
      "type": "string"
