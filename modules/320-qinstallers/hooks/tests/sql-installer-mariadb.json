            "spec": {
                "db-provision-sql": [
                    "CREATE DATABASE IF NOT EXISTS keycloak DEFAULT CHARACTER SET utf8 DEFAULT COLLATE utf8_unicode_ci;",
                    "CREATE USER IF NOT EXISTS '{qvaa-username}'@'%' IDENTIFIED BY '{qvaa-password}';",
                    "GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, INDEX, ALTER, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE, CREATE VIEW, SHOW VIEW ON keycloak.* TO '{qvaa-username}'@'%' WITH GRANT OPTION;"
                ],
                "type": "mariadb",
                "db-username": "root",
                "db-password": "{password}",
                "db-url": "172.17.0.2",
                "computed-values": [
                    {
                        "name": "password",
                        "expression": "aws_get_secret_value('mmlyle-preprod-mariadb0-db-master-password')['SecretString']"
                    },
                    {
                        "name": "qvaa-username",
                        "expression": "'qvaa'"
                    },
                    {
                        "name": "qvaa-password",
                        "expression": "get_random_string(8)"
                    }
                ],
                "post-actions": [
                    {
                        "name": "store username in vault",
                        "expression": "vault_store_secret('data/apps/qvaa/keycloak','mariadb-rds-username', 'qvaa')"
                    },
                    {
                        "name": "store password in vault",
                        "expression": "vault_store_secret('data/apps/qvaa/keycloak','mariadb-rds-password', '{qvaa-password}')"
                    }
                ]
            }
        }
